{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Attach",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "(Windows) Launch Tests x64 Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Build/Debug/x64/OmegaLocalization-Tests.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "preLaunchTask": "xmake: Build Windows x64 (Debug)"
        },
        {
            "name": "(Windows) Launch Tests x86 Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Build/Debug/x86/OmegaLocalization-Tests.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "preLaunchTask": "xmake: Build Windows x86 (Debug)"
        }
    ]
}
